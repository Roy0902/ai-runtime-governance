{
  "name": "ai-runtime-governance",
  "version": "0.1.0",
  "private": true,
  "description": "AI Runtime Governance - spec-to-verified-feature workspace",
  "license": "UNLICENSED",
  "scripts": {
    "test": "node --test",
    "ai:freeze": "node scripts/ai/freeze-guard.mjs freeze",
    "ai:lock-tests": "node scripts/ai/freeze-guard.mjs lock-tests",
    "ai:verify": "node scripts/ai/freeze-guard.mjs verify",
    "ai:contract": "node local-env/contract-tools/run.mjs",
    "test:acceptance": "playwright test --config tests/playwright.config.ts",
    "test:mail-policy": "playwright test --config tests/playwright.mail-policy.config.ts",
    "dev:frontend": "npm --prefix ../ai-runtime-governance-frontend run dev",
    "dev:backend": "mvn -f ../ai-runtime-governance-backend/pom.xml spring-boot:run",
    "build:frontend": "npm --prefix ../ai-runtime-governance-frontend run build",
    "build:backend": "mvn -f ../ai-runtime-governance-backend/pom.xml package"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
